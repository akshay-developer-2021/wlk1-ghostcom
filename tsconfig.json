{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["vite/client", "node",],
    "skipLibCheck": true
  },
  "include": ["src", "tests", "e2e", "playwright.config.ts"]
}

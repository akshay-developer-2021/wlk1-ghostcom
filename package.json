{
  "name": "wlk1-ghostcom",
  "description": "WLK-1 GHOSTCOM — encrypted P2P field radio (production)",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:local": "playwright test --project=chromium",
    "test:e2e:batch": "E2E_BATCH=10 playwright test e2e/batch-1x1.spec.ts",
    "test:e2e:remote": "E2E_BASE_URL=$SURGE_URL playwright test",
    "deploy:surge": "npm run build && surge ./dist $SURGE_DOMAIN",
    "analyze": "ANALYZE=1 vite build",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "test:e2e:all": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:firefox": "playwright test --project=firefox"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "peer": "^1.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.0",
    "workbox-precaching": "^7.4.1"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Firefox versions",
    "not dead"
  ]
}
